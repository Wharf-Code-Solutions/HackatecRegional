# Copia este archivo a .env y completa los valores. NUNCA subas el .env al repositorio.
# En Vercel, define las mismas variables en Production Y Preview, y vuelve a desplegar.

# --- Frontend (se publican en el navegador: solo claves públicas) ---
VITE_MAPBOX_TOKEN=
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# --- Desarrollo local: backend FastAPI al que apunta el proxy de Vite ---
API_TARGET=http://localhost:8000

# --- Backend (secretas; solo en el servidor) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Análisis de foto con visión. Basta UN proveedor (si están los dos, se usa Gemini).
# Comprueba en /api/health -> vision.configurado que quedó bien cargado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
#GEMINI_REASONING=
GROQ_API_KEY=
GROQ_MODEL=
#GROQ_REASONING=

# Correos de seguimiento (opcional; sin ellos se omiten)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=
APP_URL=
